{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "extras/docker/production/Dockerfile",
    "buildContext": "."
  },
  "deploy": {
    "healthcheckPath": "/en/user/login",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
